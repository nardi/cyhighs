# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = HiGHS-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/HiGHS_jll.jl/releases/download/HiGHS-v1.15.1+0/HiGHS.v1.15.1.x86_64-apple-darwin.tar.gz
source_filename = HiGHS.v1.15.1.x86_64-apple-darwin.tar.gz
