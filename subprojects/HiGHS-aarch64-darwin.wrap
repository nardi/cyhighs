# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = HiGHS-aarch64-darwin
source_url = https://github.com/JuliaBinaryWrappers/HiGHS_jll.jl/releases/download/HiGHS-v1.15.1+0/HiGHS.v1.15.1.aarch64-apple-darwin.tar.gz
source_filename = HiGHS.v1.15.1.aarch64-apple-darwin.tar.gz
source_hash = fbea22baab14d309a202c3989de738acea18b911329c64a13bb64bca6020b53b
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = HiGHS-aarch64-darwin