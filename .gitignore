# Build output
/build/
/dist/
/wheelhouse/
*.egg-info/
# meson-python's own non-editable builds (sdist, regular wheel) use a
# temporary directory matching this pattern directly under the repo root.
.mesonpy-*/

# meson-jll downloads and extracts each JLL tarball under subprojects/ at
# setup time. The *.wrap files and subprojects/packagefiles/ are the
# committed, generated inputs (see meson-jll.lock); everything else there is
# fetched output and should not be tracked.
subprojects/packagecache/
subprojects/.wraplock
subprojects/*/
!subprojects/packagefiles/

# Zensical documentation build output
/site/

# Compiled artifacts
*.so
*.pyd
*.dll
*.dylib
*.o
*.obj

# Cython generated C sources
src/cyhighs/_core.c

# Virtual environments
.venv/

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ty_cache/

# Editor and OS
.vscode/
.idea/
.DS_Store
